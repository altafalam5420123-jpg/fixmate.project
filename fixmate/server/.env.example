NODE_ENV=development
PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
OTP_RATE_MAX=10
API_RATE_MAX=300
OTP_DAILY_MAX=1000
OTP_HMAC_KEY=replace-with-a-random-secret-at-least-32-characters
TRUST_PROXY=0
DEV_SHOW_OTP=1
ALLOW_DEMO_TOPUP=1
CLIENT_ORIGIN=https://fixmate.in,https://localhost
# Twilio SMS OTP (Required in NODE_ENV=production; get from https://console.twilio.com, ~$0.0079-$0.05/SMS India)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Razorpay Payments India (Required for live UPI/Card payments; get from https://dashboard.razorpay.com, ~2% per transaction, Test mode free)
RAZORPAY_KEY_ID=rzp_test_replace_with_test_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret

# PostgreSQL Database Configuration
# Option 1: Standard Connection URL (e.g. Neon free tier at https://neon.tech, Supabase, Railway, Render)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixmate?sslmode=disable

# Option 2: Discrete connection credentials
PGHOST=localhost
PGPORT=5432
PGDATABASE=fixmate
PGUSER=postgres
PGPASSWORD=replace_with_your_postgres_password
PGSSL=false

# PostgreSQL Connection Pool Settings
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Google Gemini AI Chat (Get from https://aistudio.google.com/apikey - Free Tier available, Pay-as-you-go for high volume)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Chat & Realtime WebRTC Voice API (Get from https://platform.openai.com/api-keys - Paid, ~$0.06/min audio input + ~$0.24/min audio output)
# Note: Without OPENAI_API_KEY, OpenAI Realtime WebRTC voice sessions are BLOCKED and FixMate automatically uses Browser Web Speech STT/TTS + Gemini/Built-in NLP.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_REALTIME_VOICE=alloy
